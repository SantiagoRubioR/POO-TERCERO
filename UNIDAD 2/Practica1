class Medicamento:
    def __init__(self, codigo, nombre, precio, cajas):
        self.codigo = codigo
        self.nombre = nombre
        self.precio = precio
        self.cajas = cajas

    def vender(self, cantidad):
        if cantidad <= 0:
            print("Error: la cantidad debe ser mayor que cero.")
            return False
        if cantidad > self.cajas:
            print(f"Error: solo hay {self.cajas} cajas.")
            return False
        self.cajas -= cantidad
        return True

    def __str__(self):
        return f"{self.codigo} | {self.nombre} | ${self.precio} | {self.cajas}"

medicamentos = [
    Medicamento(1, "Paracetamol", 2.50, 30),
    Medicamento(2, "Ibuprofeno", 3.20, 20)
]

while True:
    print("1. Registrar medicamento\n2. Mostrar medicamentos\n3. Vender medicamento\n4. Salir")
    op = input("Elija una opción: ")

    if op == "1":
        nombre = input("Nombre: ")
        precio = float(input("Precio: "))
        cajas = int(input("Cajas: "))
        codigo = len(medicamentos) + 1
        medicamentos.append(Medicamento(codigo, nombre, precio, cajas))
        print(f"Registrado con el código {codigo}.")

    elif op == "2":
        print(f"\n{'Código':<6} | {'Nombre':<18} | {'Precio':<8} | Cajas")
        print("-" * 48)
        for m in medicamentos:
            print(m)

    elif op == "3":
        cod = int(input("Código del medicamento: "))
        encontrado = None
        for m in medicamentos:
            if m.codigo == cod:
                encontrado = m
                break
        if encontrado is None:
            print("Error: no existe ese código.")
        else:
            cant = int(input("Cantidad de cajas: "))
            if encontrado.vender(cant):
                print(f"Listo. Quedan {encontrado.cajas} cajas.")

    elif op == "4":
        print("Saliendo...")
        break
    else:
        print("Opción no válida.")